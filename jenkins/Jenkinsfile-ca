                } catch (Exception e) {
                    echo "Compliance Email Exception: ${e.getMessage()}"
                }
            }
        }

        failure {
            script {
                def jobBuildUrl = "${env.JENKINS_JOB_URL}/${BUILD_NUMBER}/"

                try {
                    emailext(
                        from: "${env.EMAIL_FROM}",
                        to: "${env.EMAIL_TO}",
                        subject: "❌ COMPLIANCE AUDIT FAILED | AWS Infrastructure Build #${BUILD_NUMBER}",
                        mimeType: 'text/html',
                        body: """
                        <!DOCTYPE html>
                        <html>
                        <head>
                            <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
                        </head>
                        <body>

                        <h2 style="color:red;">❌ AWS Infrastructure Compliance Audit Failed</h2>

                        <table border="1" cellpadding="6" cellspacing="0" style="border-collapse: collapse;">
                            <tr style="background-color: #f2f2f2;"><th>Field</th><th>Value</th></tr>
                            <tr><td><b>Project</b></td><td>AWS Infrastructure Compliance Audit</td></tr>
                            <tr><td><b>Build Number</b></td><td>#${BUILD_NUMBER}</td></tr>
                            <tr><td><b>Status</b></td><td><font color="red"><b>NON-COMPLIANT</b></font></td></tr>
                            <tr><td><b>Failed Audit Stage</b></td><td>${env.FAILED_STAGE}</td></tr>
                            <tr><td><b>Build URL</b></td><td><a href="${jobBuildUrl}">${jobBuildUrl}</a></td></tr>
                        </table>

                        <br>
                        <p>Please review the attached compliance reports and Jenkins console log for failed security controls.</p>

                        <br>
                        Regards,<br>
                        <b>SecDO Cloud Security & Compliance Team</b>

                        </body>
                        </html>
                        """,
                        attachmentsPattern: 'reports/*'
                    )
                } catch (Exception e) {
                    echo "Failure Email Exception: ${e.getMessage()}"
                }
            }
        }
    }
}
