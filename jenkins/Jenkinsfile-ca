                        </html>
                        """,
                        attachmentsPattern: 'reports/gitleaks-report.json, reports/checkov-report.json, reports/tfsec-report.json, reports/prowler-report.html, reports/aws-live-audit.txt, reports/aws-compliance-summary.html'
