                            <tr><td>5. tfsec AWS Misconfiguration Scan</td><td><span class="badge-pass">✅ Passed</span></td></tr>
                            <tr><td>6. Prowler AWS CIS & Security Audit</td><td><span class="badge-pass">✅ Passed</span></td></tr>
                            <tr><td>7. Live AWS Security Groups & IAM Audit</td><td><span class="badge-pass">✅ Passed</span></td></tr>
                            <tr><td>8. Executive Compliance Report</td><td><span class="badge-pass">✅ Passed</span></td></tr>
                        </table>

                        <h3>Attached Compliance Audit Reports</h3>

                        <ul>
                            <li>📄 Gitleaks Secret Audit Report (`gitleaks-report.json`)</li>
                            <li>📄 Checkov CIS Compliance Report (`checkov-report.json`)</li>
                            <li>📄 tfsec Security Audit Report (`tfsec-report.json`)</li>
                            <li>📄 Prowler AWS Security Report (`prowler-report.html`)</li>
                            <li>📄 AWS Live Security Groups & IAM Audit (`aws-live-audit.txt`)</li>
