                                a { color: #2563eb; text-decoration: none; }
                            </style>
                        </head>
                        <body>

                        <div class="success-header">🛡️ AWS Infrastructure Compliance Audit Passed</div>

                        <table>
                            <tr style="background-color: #f2f2f2;">
                                <th>Field</th>
                                <th>Value</th>
                            </tr>
                            <tr><td><b>Project</b></td><td>AWS Infrastructure Compliance Audit</td></tr>
                            <tr><td><b>Build Number</b></td><td>#${BUILD_NUMBER}</td></tr>
                            <tr><td><b>Audit Status</b></td><td><span class="badge-pass">COMPLIANT</span></td></tr>
                            <tr><td><b>AWS Account ID</b></td><td>${AWS_ACCOUNT_ID}</td></tr>
                            <tr><td><b>AWS Region</b></td><td>${AWS_REGION}</td></tr>
                            <tr><td><b>Build URL</b></td><td><a href="${jobBuildUrl}">${jobBuildUrl}</a></td></tr>
                        </table>

                        <h3>Executed Compliance Controls</h3>

                        <table>
                            <tr style="background-color: #f2f2f2;">
                                <th>Audit Control</th>
                                <th>Status</th>
                            </tr>
