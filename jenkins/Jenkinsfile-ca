                            <tr><td>2. Gitleaks Secret & Credential Audit</td><td><span class="badge-pass">✅ Passed</span></td></tr>
                            <tr><td>3. Terraform Syntax & Format Audit</td><td><span class="badge-pass">✅ Passed</span></td></tr>
