pipeline {
    agent any

    /**********************************************************************
     * TRIGGERS
     **********************************************************************/
    triggers {
        // Execute compliance audit every day at midnight
        cron('0 0 * * *')
    }

    /**********************************************************************
     * GLOBAL ENVIRONMENT VARIABLES
     **********************************************************************/
    environment {

        // AWS Configuration
        AWS_REGION      = "${env.AWS_REGION ?: 'ap-south-1'}"
        AWS_ACCOUNT_ID  = "325698037625"

        // Email Configuration
        EMAIL_FROM = "patilrahulprafulla@gmail.com"
        EMAIL_TO   = "patilrahulprafulla1@gmail.com,dangerushi19@gmail.com,ameybhalerao004@gmail.com,ashutoshkabade1961@gmail.com"

        // Jenkins
        JENKINS_JOB_URL = "http://secdo-alb-124066993.ap-south-1.elb.amazonaws.com:8080/job/Compliance"

        // AWS Load Balancer
        ALB_DNS_NAME = "secdo-alb-124066993.ap-south-1.elb.amazonaws.com"

        // Git Branch
        BRANCH = "main"

        // Used in failure email
        FAILED_STAGE = "Not Started"

        // Reports Directory
        REPORT_DIR = "reports"
    }

    /**********************************************************************
     * PIPELINE OPTIONS
     **********************************************************************/
    options {

        timeout(time: 45, unit: 'MINUTES')

        disableConcurrentBuilds()

        timestamps()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '20'
            )
        )
    }

    /**********************************************************************
     * STAGES
     **********************************************************************/
    stages {

        /******************************************************************
         * STAGE 1
         ******************************************************************/
        stage('1. Checkout Infrastructure Repository') {

            steps {

                script {
                    env.FAILED_STAGE = '1. Checkout Infrastructure Repository'
                }

                echo ""
                echo "=================================================================="
                echo " STAGE 1 : CHECKOUT INFRASTRUCTURE REPOSITORY"
                echo "=================================================================="

                checkout scm

                sh '''
                    mkdir -p ${REPORT_DIR}

                    echo ""
                    echo "Repository Successfully Checked Out"
                    echo ""

                    echo "Workspace"
                    pwd

                    echo ""
                    echo "Current Branch"
                    git branch

                    echo ""
                    echo "Latest Commit"
                    git log -1 --oneline

                    echo ""
                    echo "Repository Contents"
                    ls -lah
                '''

                echo ""
                echo "Repository Checkout Completed Successfully"
                echo ""
            }
        }

        /******************************************************************
         * STAGE 2
         ******************************************************************/
        stage('2. Gitleaks Secret & Credential Leak Audit') {

            steps {

                script {
                    env.FAILED_STAGE = '2. Gitleaks Secret & Credential Leak Audit'
                }

                echo ""
                echo "=================================================================="
                echo " STAGE 2 : GITLEAKS SECRET & CREDENTIAL AUDIT"
                echo "=================================================================="

                sh '''

                    set +e

                    echo ""
                    echo "Starting Repository Secret Scan..."
                    echo ""

                    docker pull zricethezav/gitleaks:latest

                    docker run --rm \
                        -v "$(pwd):/workspace" \
                        zricethezav/gitleaks:latest detect \
                        --source="/workspace" \
                        --report-format json \
                        --report-path "/workspace/${REPORT_DIR}/gitleaks-report.json" \
                        --verbose

                    RESULT=$?

                    echo ""
                    echo "--------------------------------------------------------------"

                    if [ $RESULT -eq 0 ]; then
                        echo "PASS : No hardcoded secrets detected."
                    else
                        echo "WARNING : Potential secrets detected."
                        echo "Please review:"
                        echo "${REPORT_DIR}/gitleaks-report.json"
                    fi

                    echo "--------------------------------------------------------------"

                    if [ -f ${REPORT_DIR}/gitleaks-report.json ]; then
                        echo ""
                        echo "Generated Reports"
                        ls -lh ${REPORT_DIR}
                    fi

                    echo ""
                    echo "Gitleaks Scan Completed"
                    echo ""

                    exit 0
                '''

                echo ""
                echo "Stage 2 Completed Successfully"
                echo ""
            }
        }

        /******************************************************************
         * STAGE 3
         ******************************************************************/
        stage('3. Terraform Syntax & Format Audit') {

            steps {

                script {
                    env.FAILED_STAGE = '3. Terraform Syntax & Format Audit'
                }

                echo ""
                echo "=================================================================="
                echo " STAGE 3 : TERRAFORM FORMAT, INITIALIZATION & VALIDATION"
                echo "=================================================================="

                sh '''

                    set +e

                    echo ""
                    echo "Terraform Working Directory"
                    echo "--------------------------------------------------------------"

                    ls -lah terraform

                    echo ""
                    echo "Pulling Latest Terraform Image..."
                    docker pull hashicorp/terraform:latest

                    echo ""
                    echo "--------------------------------------------------------------"
                    echo "Terraform Format Validation"
                    echo "--------------------------------------------------------------"

                    docker run --rm \
                        -v "$(pwd)/terraform:/workspace" \
                        -w /workspace \
                        hashicorp/terraform:latest \
                        fmt -check -recursive

                    FMT_STATUS=$?

                    echo ""
                    echo "--------------------------------------------------------------"
                    echo "Terraform Initialization"
                    echo "--------------------------------------------------------------"

                    docker run --rm \
                        -v "$(pwd)/terraform:/workspace" \
                        -w /workspace \
                        hashicorp/terraform:latest \
                        init -backend=false

                    INIT_STATUS=$?

                    echo ""
                    echo "--------------------------------------------------------------"
                    echo "Terraform Configuration Validation"
                    echo "--------------------------------------------------------------"

                    docker run --rm \
                        -v "$(pwd)/terraform:/workspace" \
                        -w /workspace \
                        hashicorp/terraform:latest \
                        validate

                    VALIDATE_STATUS=$?

                    echo ""
                    echo "==================== SUMMARY ===================="

                    if [ $FMT_STATUS -eq 0 ]; then
                        echo "Terraform Formatting        : PASS"
                    else
                        echo "Terraform Formatting        : WARNING"
                    fi

                    if [ $INIT_STATUS -eq 0 ]; then
                        echo "Terraform Initialization    : PASS"
                    else
                        echo "Terraform Initialization    : WARNING"
                    fi

                    if [ $VALIDATE_STATUS -eq 0 ]; then
                        echo "Terraform Validation        : PASS"
                    else
                        echo "Terraform Validation        : WARNING"
                    fi

                    echo "================================================="

                    exit 0
                '''

                echo ""
                echo "Terraform Audit Completed Successfully"
                echo ""
            }
        }

        /******************************************************************
         * STAGE 4
         ******************************************************************/
        stage('4. Checkov CIS Benchmarks & Compliance Audit') {

            steps {

                script {
                    env.FAILED_STAGE = '4. Checkov CIS Benchmarks & Compliance Audit'
                }

                echo ""
                echo "=================================================================="
                echo " STAGE 4 : CHECKOV IaC SECURITY & COMPLIANCE SCAN"
                echo "=================================================================="

                sh '''

                    set +e

                    echo ""
                    echo "Scanning Terraform Infrastructure..."
                    echo ""

                    docker pull bridgecrew/checkov:latest

                    docker run --rm \
                        -v "$(pwd)/terraform:/tf" \
                        -v "$(pwd)/reports:/reports" \
                        --workdir /tf \
                        bridgecrew/checkov:latest \
                        -d . \
                        --framework terraform \
                        --compact \
                        --quiet \
                        --output cli \
                        --output json \
                        --output-file-path console,/reports/checkov-report.json

                    CHECKOV_STATUS=$?

                    echo ""
                    echo "--------------------------------------------------------------"

                    if [ $CHECKOV_STATUS -eq 0 ]; then
                        echo "Compliance Scan Completed Successfully"
                    else
                        echo "Compliance Violations Detected"
                    fi

                    echo "--------------------------------------------------------------"

                    if [ -f reports/checkov-report.json ]; then
                        echo ""
                        echo "Generated Compliance Report"
                        ls -lh reports/checkov-report.json
                    else
                        echo ""
                        echo "Checkov Report Not Generated"
                    fi

                    echo ""
                    echo "Audited Security Frameworks"
                    echo "--------------------------------------------------------------"
                    echo "✔ CIS Benchmarks"
                    echo "✔ AWS Security Best Practices"
                    echo "✔ PCI-DSS"
                    echo "✔ HIPAA"
                    echo "✔ NIST"
                    echo "✔ Infrastructure as Code"

                    echo ""
                    echo "Checkov Compliance Scan Completed"

                    exit 0
                '''

                echo ""
                echo "Stage 4 Completed Successfully"
                echo ""
            }
        }

        /******************************************************************
         * STAGE 5
         ******************************************************************/
        stage('5. tfsec AWS Security Misconfiguration Scan') {

            steps {

                script {
                    env.FAILED_STAGE = '5. tfsec AWS Security Misconfiguration Scan'
                }

                echo ""
                echo "=================================================================="
                echo " STAGE 5 : TFSEC AWS SECURITY MISCONFIGURATION AUDIT"
                echo "=================================================================="

                sh '''

                    set +e

                    echo ""
                    echo "Starting tfsec Infrastructure Security Scan..."
                    echo ""

                    docker pull aquasec/tfsec:latest

                    docker run --rm \
                        -v "$(pwd):/src" \
                        aquasec/tfsec:latest \
                        /src/terraform \
                        --format json \
                        --out /src/reports/tfsec-report.json

                    TFSEC_STATUS=$?

                    echo ""
                    echo "--------------------------------------------------------------"

                    if [ $TFSEC_STATUS -eq 0 ]; then
                        echo "✓ No AWS Security Misconfigurations Detected."
                    else
                        echo "⚠ Security Findings Detected."
                        echo "Please review reports/tfsec-report.json"
                    fi

                    echo "--------------------------------------------------------------"

                    if [ -f reports/tfsec-report.json ]; then

                        echo ""
                        echo "Generated Report"

                        ls -lh reports/tfsec-report.json

                    else

                        echo ""
                        echo "No tfsec report generated."

                    fi

                    echo ""
                    echo "Security Controls Checked"
                    echo "--------------------------------------------------------------"
                    echo "✔ Security Groups"
                    echo "✔ IAM Policies"
                    echo "✔ EC2 Instances"
                    echo "✔ S3 Buckets"
                    echo "✔ RDS"
                    echo "✔ Encryption"
                    echo "✔ Networking"
                    echo "✔ Public Access"
                    echo "✔ Least Privilege"

                    echo ""
                    echo "tfsec Scan Completed"

                    exit 0
                '''

                echo ""
                echo "Stage 5 Completed Successfully"
                echo ""
            }
        }

        /******************************************************************
         * STAGE 6
         ******************************************************************/
        stage('6. Prowler AWS CIS & Security Compliance Audit') {

            steps {

                script {
                    env.FAILED_STAGE = '6. Prowler AWS CIS & Security Compliance Audit'
                }

                echo ""
                echo "=================================================================="
                echo " STAGE 6 : PROWLER AWS LIVE SECURITY AUDIT"
                echo "=================================================================="

                sh '''

                    set +e

                    echo ""
                    echo "Starting Live AWS Compliance Assessment..."
                    echo ""

                    docker pull toniblyx/prowler:latest

                    docker run --rm \
                        -e AWS_REGION=${AWS_REGION} \
                        -v "$(pwd)/reports:/prowler/output" \
                        toniblyx/prowler:latest \
                        aws \
                        --region ${AWS_REGION} \
                        --services iam s3 ec2 ecr elbv2 \
                        --output-formats json html \
                        --output-filename prowler-report

                    PROWLER_STATUS=$?

                    echo ""
                    echo "--------------------------------------------------------------"

                    if [ $PROWLER_STATUS -eq 0 ]; then
                        echo "✓ Live AWS Compliance Audit Completed."
                    else
                        echo "⚠ Compliance Findings Detected."
                    fi

                    echo "--------------------------------------------------------------"

                    echo ""
                    echo "Audited AWS Services"
                    echo "--------------------------------------------------------------"
                    echo "✔ IAM"
                    echo "✔ EC2"
                    echo "✔ S3"
                    echo "✔ ELB"
                    echo "✔ ECR"

                    echo ""
                    echo "Compliance Frameworks"
                    echo "--------------------------------------------------------------"
                    echo "✔ CIS AWS Foundations"
                    echo "✔ AWS Security Best Practices"
                    echo "✔ NIST"
                    echo "✔ PCI-DSS"
                    echo "✔ HIPAA"

                    echo ""

                    if [ -d reports ]; then
                        ls -lh reports
                    fi

                    echo ""
                    echo "Prowler Audit Completed"

                    exit 0
                '''

                echo ""
                echo "Stage 6 Completed Successfully"
                echo ""
            }
        }

        /******************************************************************
         * STAGE 7
         ******************************************************************/
        stage('7. Live AWS Security Groups, IAM Roles & Policy Audit') {

            steps {

                script {
                    env.FAILED_STAGE = '7. Live AWS Security Groups, IAM Roles & Policy Audit'
                }

                echo ""
                echo "=================================================================="
                echo " STAGE 7 : LIVE AWS SECURITY GROUPS & IAM AUDIT"
                echo "=================================================================="

                sh '''

                    set +e

                    REPORT=reports/aws-live-audit.txt

                    echo "Generating Live AWS Infrastructure Audit..."
                    echo ""

                    cat > $REPORT <<EOF
=====================================================================
                SecDO AWS Live Infrastructure Audit
=====================================================================

AWS Account : ${AWS_ACCOUNT_ID}
AWS Region  : ${AWS_REGION}
Build Number: ${BUILD_NUMBER}
Audit Time  : $(date)

=====================================================================

1. SECURITY GROUPS
---------------------------------------------------------------------

EOF

                    aws ec2 describe-security-groups \
                        --region ${AWS_REGION} \
                        --query "SecurityGroups[*].{GroupId:GroupId,GroupName:GroupName,InboundRules:IpPermissions}" \
                        --output table >> $REPORT || true

                    cat >> $REPORT <<EOF

=====================================================================

2. IAM INSTANCE PROFILES
---------------------------------------------------------------------

EOF

                    aws iam list-instance-profiles \
                        --output table >> $REPORT || true

                    cat >> $REPORT <<EOF

=====================================================================

3. IAM ROLES
---------------------------------------------------------------------

EOF

                    aws iam list-roles \
                        --output table >> $REPORT || true

                    cat >> $REPORT <<EOF

=====================================================================

4. CUSTOMER MANAGED IAM POLICIES
---------------------------------------------------------------------

EOF

                    aws iam list-policies \
                        --scope Local \
                        --output table >> $REPORT || true

                    cat >> $REPORT <<EOF

=====================================================================
Audit Completed Successfully
=====================================================================
EOF

                    echo ""
                    echo "Audit Report Generated"

                    ls -lh $REPORT

                    echo ""
                    echo "Preview"
                    echo "--------------------------------------------------------------"

                    head -40 $REPORT

                    exit 0
                '''

                echo ""
                echo "Stage 7 Completed Successfully"
                echo ""
            }
        }

        /******************************************************************
         * STAGE 8
         ******************************************************************/
        stage('8. Executive Compliance Summary Report') {

            steps {

                script {
                    env.FAILED_STAGE = '8. Executive Compliance Summary Report'
                }

                echo ""
                echo "=================================================================="
                echo " STAGE 8 : EXECUTIVE COMPLIANCE REPORT"
                echo "=================================================================="

                sh '''

cat > reports/aws-compliance-summary.html <<EOF
